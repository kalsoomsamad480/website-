PORT=5000
NODE_ENV=development

# Local MongoDB or an Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/study_mind
# true = run a temporary in-memory MongoDB and auto-seed it (no install needed; data resets on restart)
USE_MEMORY_DB=false

# Use long random strings
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

CLIENT_URL=http://localhost:5173
AGENT_URL=http://localhost:8000

# Shared secret the Python assistant sends (must match agent/.env)
AGENT_SECRET=change_me_too_and_share_with_agent
