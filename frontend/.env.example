# Default uses the Vite dev proxy (/api -> http://localhost:5000)
VITE_API_URL=/api/v1

# Public origin used for sitemap.xml and robots.txt at build time
VITE_SITE_URL=http://localhost:5173

# Show one-click demo accounts on the sign-in page in production builds (demo sites only)
VITE_SHOW_DEMO_ACCOUNTS=false
