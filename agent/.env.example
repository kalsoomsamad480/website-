# Optional: with a key the assistant uses Claude; without one it runs in built-in rules mode
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Node API the agent reads menu, info, offers, and availability from
BACKEND_URL=http://localhost:5000/api/v1

SESSION_TTL_MINUTES=30
MAX_HISTORY_TURNS=10

# Must match AGENT_SECRET in backend/.env
AGENT_SECRET=
