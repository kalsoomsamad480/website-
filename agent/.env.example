# Optional: with a key the assistant uses an LLM; without one it runs in built-in rules mode
LLM_API_KEY=
# Leave LLM_BASE_URL empty for Claude. For a free OpenAI-compatible provider, set it, e.g.
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai  (LLM_MODEL defaults to gemini-flash-latest)
#   Groq:          https://api.groq.com/openai/v1                           (set LLM_MODEL too)
LLM_BASE_URL=
LLM_MODEL=

# Node API the agent reads menu, info, offers, and availability from
BACKEND_URL=http://localhost:5000/api/v1

SESSION_TTL_MINUTES=30
MAX_HISTORY_TURNS=10

# Must match AGENT_SECRET in backend/.env
AGENT_SECRET=
